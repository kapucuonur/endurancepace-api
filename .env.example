# Copy to .env and adjust. All vars are prefixed ENDURANCEPACE_.

# SQLAlchemy URL. SQLite by default (matches the bikefit-api pattern).
ENDURANCEPACE_DATABASE_URL=sqlite:///./endurancepace.db

# JWT signing — CHANGE THIS in production. Same scheme as bikefit-api (HS256, sub=email).
ENDURANCEPACE_JWT_SECRET_KEY=change-me-in-production
ENDURANCEPACE_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins (native app is unaffected — it sends no Origin).
# Default is the Expo web dev ports. Add your real web domain before launch.
# "*" works but is opt-in.
ENDURANCEPACE_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Allow POST /me/reset to wipe + reseed the caller's data. Keep false in prod.
ENDURANCEPACE_ALLOW_RESET=false

# Swagger UI / OpenAPI schema. Off by default; true only for local dev.
ENDURANCEPACE_ENABLE_DOCS=false

# Rate limit the auth routes (login 10/min, signup 5/hour). Keep true in prod.
ENDURANCEPACE_RATELIMIT_ENABLED=true

# Port for `uvicorn` / local dev (prod: 8006, behind the Cloudflare Tunnel).
ENDURANCEPACE_PORT=8006

# --- Garmin sync ------------------------------------------------------------
# Fernet key — encrypts stored Garmin passwords + session token blobs.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENDURANCEPACE_FIELD_ENCRYPT_KEY=

# First-connect backfill window and per-sync cap.
ENDURANCEPACE_GARMIN_SYNC_DEFAULT_DAYS=30
ENDURANCEPACE_GARMIN_SYNC_ACTIVITY_LIMIT=100

# Debounce for pull-to-refresh; abandoned-MFA TTL; SSO 429 cooldown (seconds).
ENDURANCEPACE_GARMIN_SYNC_MIN_INTERVAL_SECONDS=120
ENDURANCEPACE_GARMIN_MFA_TTL_SECONDS=600
ENDURANCEPACE_GARMIN_LOGIN_COOLDOWN_SECONDS=900

# Best-effort sync triggered from GET /me/snapshot.
ENDURANCEPACE_GARMIN_SYNC_ON_SNAPSHOT=false

# Garmin activityType.typeKey substring -> our sport (first match wins).
ENDURANCEPACE_GARMIN_SPORT_MAP=swimming=swim,cycling=bike,biking=bike,ride=bike,running=run,strength_training=strength

# Disk fallback dir for garth token dumps (session-resume ladder tier 2).
ENDURANCEPACE_GARMIN_SESSION_DIR=~/.endurancepace_garth
